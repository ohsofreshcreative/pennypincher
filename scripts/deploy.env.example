# Konfiguracja wdrożenia – skopiuj do scripts/deploy.env (plik jest w .gitignore) i uzupełnij.
# Nie wpisuj tu haseł ani kluczy prywatnych – tylko ścieżkę do klucza SSH trzymanego POZA repozytorium.

DEPLOY_HOST="147.93.60.77"
DEPLOY_PORT="65002"
DEPLOY_USER="u679500043"
# Katalog główny WordPressa na serwerze (tam, gdzie wp-config.php).
DEPLOY_WP_PATH="/home/u679500043/domains/pennypincher.ohsofresh.top/public_html"
DEPLOY_URL="https://pennypincher.ohsofresh.top"
# Nowy klucz SSH (np. ~/.ssh/pennypincher_deploy_ed25519). Klucz z repozytorium jest zablokowany.
DEPLOY_SSH_KEY="$HOME/.ssh/pennypincher_deploy_ed25519"
# Katalog kopii zapasowych na serwerze (poza public_html).
DEPLOY_BACKUP_DIR="/home/u679500043/backups/pennypincher"
# Polecenie WP-CLI na serwerze (na Hostingerze zwykle po prostu "wp").
DEPLOY_WP_CLI="wp"
