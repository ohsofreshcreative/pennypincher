# wp-content/uploads – blokada wykonywania skryptów (pliki z uploadu nigdy nie powinny być wykonywane).
# Instaluje go scripts/deploy.sh tylko wtedy, gdy w uploads nie ma jeszcze .htaccess.
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
	Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
